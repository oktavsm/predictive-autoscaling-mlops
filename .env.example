# ==========================================
# Predictive Autoscaling MLOps - Environment Variables
# ==========================================

# ------------------------------------------
# 1. Prometheus / Monitoring
# ------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------
# 2. MLflow (Model Tracking & Registry)
# ------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
# Uncomment below if using MinIO/S3 for MLflow Artifacts
# MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ------------------------------------------
# 3. DVC (Data Version Control)
# ------------------------------------------
# Configure remote storage for dataset versioning
# DVC_REMOTE_URL=s3://my-dvc-bucket/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------
# 4. Inference API
# ------------------------------------------
INFERENCE_API_HOST=0.0.0.0
INFERENCE_API_PORT=8000
INFERENCE_MODEL_NAME=predictive-autoscaler
INFERENCE_MODEL_VERSION=production

# ------------------------------------------
# 5. Kubernetes Scaling Controller
# ------------------------------------------
# KUBECONFIG=~/.kube/config
K8S_NAMESPACE=default
TARGET_DEPLOYMENT_NAME=laravel-backend
MIN_REPLICAS=1
MAX_REPLICAS=10
SCALING_COOLDOWN_SECONDS=60

# ------------------------------------------
# 6. Data Ingestion Pipeline
# ------------------------------------------
METRICS_COLLECTION_INTERVAL=1m
DATASET_STORAGE_PATH=./src/data/raw

# ------------------------------------------
# 7. Backend Target (Laravel)
# ------------------------------------------
LARAVEL_API_URL=http://laravel-backend:80

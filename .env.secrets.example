# =============================================================================
# CLUSTER & APPLICATION CREDENTIALS TEMPLATE
# Copy to .env.secrets (which is gitignored) and fill in real values:
#   cp .env.secrets.example .env.secrets
# =============================================================================

# 1. K3s Cluster Node Token (CP -> Worker join)
K3S_NODE_TOKEN=K10yournode_token_here::server:your_server_token_here

# 2. Grafana Admin Password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# 3. Infrastructure Dependencies (PostgreSQL & MinIO)
DB_USERNAME=titipin_user
DB_PASSWORD=your_strong_db_password
DB_DATABASE=titipin_db
MINIO_ROOT_USER=titipin_minio
MINIO_ROOT_PASSWORD=your_strong_minio_password

# 4. Laravel Backend Application Key
APP_KEY=base64:your_generated_app_key_here

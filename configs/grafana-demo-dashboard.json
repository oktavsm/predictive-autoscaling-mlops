{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "1. API Request Rate",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(caddy_http_requests_total{host=~\"api.titipin.me.*\"}[1m]))",
          "legendFormat": "Request Rate",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "2. API p95 Latency",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket{host=~\"api.titipin.me.*\"}[1m])))",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "3. Laravel PHP CPU Usage",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "cores"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"titipin\", pod=~\"laravel-backend-.*\", container=\"php\"}[1m]))",
          "legendFormat": "PHP CPU (cores)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "4. Laravel PHP Memory Usage",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"titipin\", pod=~\"laravel-backend-.*\", container=\"php\"})",
          "legendFormat": "PHP Memory",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "title": "5. Backend Replica Count",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 },
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{namespace=\"titipin\", deployment=\"laravel-backend\"}",
          "legendFormat": "Total Replicas",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_ready{namespace=\"titipin\", deployment=\"laravel-backend\"}",
          "legendFormat": "Ready Replicas",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
